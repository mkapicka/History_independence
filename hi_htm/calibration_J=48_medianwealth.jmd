# 1. Calibration
Calibration with the default settings. Running the file as a script produces the same log and archives it in `calibration_results/` automatically.
Parameter override calib = CalibrationParams(inner_xtol = 1e-7) and lambdaMin = 1e-6 needed to ensure convergence of the calibration search: the default lambdaMin=0.2 was not sufficient (The calibration searches qSav over [0.900, 1.040]. At the lower end, qSav = 0.900 is an 11.1% return on saving, and compounded over 100 periods that gives enormous assets — so the budget-clearing λ collapses to 0.059, below lambdaMin = 0.20.)

 
julia --project=. -t 5
  include("calibrate_history_independent_tax_beta.jl")
result_calib = calibrate_history_independent_tax_beta(
           calib = BetaCalibration(asset_moment = :median,
                                   medianAssetsToMeanLaborIncome = 62442/52745, trueBorrowingLimitToMeanLaborIncome=0.185,
                                   beta_min = 0.975, beta_max = 0.995),
           J = 47, nZ = 15, nEps = 11, nKappa = 5, nA = 151,
           qSav = 1/1.0167, qBorr = 1/1.0167, qGov = 1/1.0167,
           aMax=50.0, lambdaMin = 1e-5);

=== Beta calibration targets ===
median assets / mean labor income        = 1.18384681
true borrowing limit / mean labor income = 0.18500000
share negative liquid assets             : NOT TARGETED (reported only)
prices (GIVEN, not calibrated)           : qSav=0.983574 qBorr=0.983574 qGov=0.983574
access chain (GIVEN, not calibrated)     : pSS=0.888297 pHH=0.758929 -> piH=0.316642
                                         : persistent access; piH does not separate pSS from pHH
                                         : one price everywhere, so PV(T) = G telescopes exactly
beta bracket                             : [0.975000, 0.995000]  (beta_max at or above qSav -- fine in a finite horizon)
horizon                                  : J = 47 (48 periods, j = 0..J)

=== Calibration search ===
start:   beta=0.975000 bbar=-0.172300

eval   beta        bbar        median/LI   trueBL/LI   neg share max
   1  0.97500000  -0.17230000  0.34102748  0.18200426  0.17291008 8e-01
   2  0.98760900  -0.17513754  1.18399335  0.18429405  0.04413935 7e-04
   3  0.98761155  -0.17580888  1.18396144  0.18499984  0.04419345 1e-04

=== History-independent tax finite-horizon solver ===
Options:
  age dimension J             = 47
  shock grid dimension nZ     = 15
  shock grid dimension nEps   = 11
  shock grid dimension nKappa = 5
  z_discretization_method     = :rouwenhorst  (alternatives: :rouwenhorst, :tauchen)
  tauchen_width               = 3.000  (used when z_discretization_method = :tauchen)
  asset grid dimension nA     = 151
  asset_grid_method           = :nonuniform  (alternatives: :nonuniform, :linear)
  asset_grid_borrow_share     = 0.350
  asset_grid_curvatures       = borrow 1.800, save 2.500
  asset_grid_zero_band        = share 0.300, width 0.080
  asset_grid_bounds           = [-1.741903, 50.000000]
  bbar                        = -0.17580888299687308
  pSS (stay saver)            = 0.8882970895          (s in psmodel.tex)
  pHH (stay hand-to-mouth)    = 0.7589294614          (h in psmodel.tex)
  access shares (piS, piH)    = (0.68335794, 0.31664206)
  qSav                        = 0.983574309039048     (price of saving,    a' >= 0)
  qBorr                       = 0.983574309039048     (price of borrowing, a' < 0)
  qGov                        = 0.983574              (government discount price)
  G                           = 0.000000              (government spending)
  asset_choice_method         = :grid_search  (alternatives: :grid_search, :interpolate)
  labor_solver                = :hybrid_newton  (alternatives: :brent, :hybrid_newton, :grid)
  labor_bounds                = [1.00e-08, 5.0000]
  terminal_borrowing          = :zero
  lambda_solver               = :brent  (Roots.jl; fallback: grid search over 15 values)
  lambda_bracket              = [0.000010, 2.500000], tol = 1.00e-05
  collect_distributions       = false

