# 1. Verification of the history-independent tax solver No.1
run the history-dependent tax solver with `mu1 = mu2 = 0` and `nS1 = nS2 = 1` to verify that it reproduces the history-independent tax results exactly.

result = run_history_dependent_tax(mu1=0.0, mu2=0.0,  labor_grid_size=101);

=== History-dependent tax finite-horizon solver ===
Options:
  age dimension J               = 39
  shock grid dimension nZ       = 5
  shock grid dimension nEps     = 5
  shock grid dimension nKappa   = 3
  z_discretization_method       = :rouwenhorst  (alternatives: :rouwenhorst, :tauchen)
  asset grid dimension nA       = 101
  asset grid bounds             = [-0.552187, 15.000000]
  asset grid method             = :nonuniform  (alternatives: :nonuniform, :linear)
  bbar                          = -0.17014842731387517
  labor grid size               = 101 on [0.0500, 5.0000]
  labor grid spacing            = :log  (alternatives: :log, :uniform)
  exploit_hours_monotonicity    = true
  labor history 1 dimension nS1 = 1
  labor history 1 bounds        = [0.0000, 0.0000]
  labor history 1 grid method   = :linear
  labor history 2 dimension nS2 = 1
  labor history 2 bounds        = [0.0000, 0.0000]
  labor history 2 grid method   = :linear
  qSav                          = 0.9723466284755885
  qBorr                         = 1.0123473140001613
  theta0 (implied)              = 1.000000
  alpha                         = 0.500000
  mu1, mu2                      = 0.000000, 0.000000
  hours exponent (1-tau)*theta0 = 0.819000
  s_hours_floor                 = 0.0500
  terminal_borrowing            = :zero
  lambda_solver                 = :brent  (Roots.jl; fallback: grid search over 15 values)
  lambda_bracket                = [0.200000, 2.500000], tol = 1.00e-06
  collect_distributions         = true

